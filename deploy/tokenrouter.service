# tokenrouter.service runs the installed application through systemd using the
# tokenrouter service account. The unit binds the executable to its installation
# directory, restarts the service after failures, and limits writes to the
# application directory through systemd security settings.

[Unit]
Description=TokenRouter - AI API Gateway Platform
Documentation=https://github.com/kiroo92/TokenRouter
After=network.target postgresql.service redis.service
Wants=postgresql.service redis.service

[Service]
Type=simple
User=tokenrouter
Group=tokenrouter
WorkingDirectory=/opt/tokenrouter
ExecStart=/opt/tokenrouter/tokenrouter
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=tokenrouter

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/tokenrouter

# Environment - Server configuration
# Modify these values to change listen address and port
Environment=GIN_MODE=release
Environment=SERVER_HOST=0.0.0.0
Environment=SERVER_PORT=8080

[Install]
WantedBy=multi-user.target
